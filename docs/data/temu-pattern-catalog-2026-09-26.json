      "dom": {
        "stableHook": "span[class] or div[class] with whole text = phrase",
        "unstableClassHashes": ["_2h8Ne7BR", "_1FxJ41PO", "_2_ku4rfX"],
        "dataType": null
      },
      "extensionAction": "hide",
      "surfaces": ["home", "search", "pdp_socks"],
